# .env.local болгон хуулж утгуудыг бөглөнө. Vercel дээр Project → Settings → Environment Variables-д мөн оруулна.

# Админ хэсгийн (/admin) нууц үг — заавал.
ADMIN_PASSWORD=

# Supabase (мэдээ хадгална): Project Settings → API → Project URL ба service_role түлхүүр.
# service_role түлхүүрийг хэзээ ч клиент кодонд эсвэл NEXT_PUBLIC_ хувьсагчид бүү тавь.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Заавал биш: Steam-ийн мэдээг AI-аар орчуулах.
ANTHROPIC_API_KEY=

# Локал сервер дээрх тоглоомын өгөгдлийн автомат шинэчлэлтийг унтраах бол: AUTO_UPDATE=off
